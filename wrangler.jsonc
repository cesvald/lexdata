{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lexdata",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dataprivo-leads",
      "database_id": "8b044e6e-2341-4bbf-942e-dbeaba66e0a1"
    }
  ],
  "vars": {
    "LEAD_TO_EMAIL": "valderramago@gmail.com",
    "LEAD_FROM_EMAIL": "DataPrivo <onboarding@resend.dev>"
  }
}
